+      rpKey.push_back(uint32_t(VK_ATTACHMENT_STORE_OP_STORE));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_LOAD_OP_DONT_CARE));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_STORE_OP_DONT_CARE));
+      rpKey.push_back(uint32_t(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL));
+    }
+    VkFormat depthFmt = rtInfo.depthAttachmentFormat != VK_FORMAT_UNDEFINED
+      ? rtInfo.depthAttachmentFormat : rtInfo.stencilAttachmentFormat;
+    rpKey.push_back(uint32_t(depthFmt));
+    if (depthFmt != VK_FORMAT_UNDEFINED) {
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_LOAD_OP_DONT_CARE));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_STORE_OP_STORE));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_LOAD_OP_DONT_CARE));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_STORE_OP_STORE));
+      rpKey.push_back(uint32_t(VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL));
+    }
+
+    std::lock_guard<std::mutex> lock(m_compatMutex);
+    auto it = m_compatRenderPasses.find(rpKey);
+    if (it != m_compatRenderPasses.end())
+      return it->second;
+
+    std::vector<VkAttachmentDescription> atts;
+    std::vector<VkAttachmentReference> colorRefs;
+    for (uint32_t i = 0; i < rtInfo.colorAttachmentCount; ++i) {
+      VkFormat fmt = rtInfo.pColorAttachmentFormats ? rtInfo.pColorAttachmentFormats[i] : VK_FORMAT_UNDEFINED;
+      if (fmt == VK_FORMAT_UNDEFINED) {
+        colorRefs.push_back({ VK_ATTACHMENT_UNUSED, VK_IMAGE_LAYOUT_UNDEFINED });
+        continue;
+      }
+      VkAttachmentDescription d = {};
+      d.format = fmt;
+      d.samples = VK_SAMPLE_COUNT_1_BIT;
+      d.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+      d.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      d.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+      d.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+      d.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      d.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      colorRefs.push_back({ uint32_t(atts.size()), VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL });
+      atts.push_back(d);
+    }
+
+    VkAttachmentReference depthRef = { VK_ATTACHMENT_UNUSED, VK_IMAGE_LAYOUT_UNDEFINED };
+    if (depthFmt != VK_FORMAT_UNDEFINED) {
+      VkAttachmentDescription d = {};
+      d.format = depthFmt;
+      d.samples = VK_SAMPLE_COUNT_1_BIT;
+      d.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+      d.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      d.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+      d.stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE;
+      d.initialLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+      d.finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+      depthRef = { uint32_t(atts.size()), VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL };
+      atts.push_back(d);
+    }
+
+    VkSubpassDescription subpass = {};
+    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    subpass.colorAttachmentCount = uint32_t(colorRefs.size());
+    subpass.pColorAttachments = colorRefs.empty() ? nullptr : colorRefs.data();
+    subpass.pDepthStencilAttachment = (depthFmt != VK_FORMAT_UNDEFINED) ? &depthRef : nullptr;
+
+    VkRenderPassCreateInfo rpInfo = { VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO };
+    rpInfo.attachmentCount = uint32_t(atts.size());
+    rpInfo.pAttachments = atts.empty() ? nullptr : atts.data();
+    rpInfo.subpassCount = 1;
+    rpInfo.pSubpasses = &subpass;
+
+    VkRenderPass rp = VK_NULL_HANDLE;
+    if (m_vkd->vkCreateRenderPass(m_vkd->device(), &rpInfo, nullptr, &rp) != VK_SUCCESS)
+      throw DxvkError("Failed to create compat pipeline VkRenderPass");
+    m_compatRenderPasses.emplace(std::move(rpKey), rp);
+    return rp;
+  }
+
+
+  void DxvkDevice::beginCompatRenderPass(VkCommandBuffer cmdBuffer, const VkRenderingInfo* info) {
+    std::lock_guard<std::mutex> lock(m_compatMutex);
+
+    auto getFmt = [&](VkImageView v) -> VkFormat {
+      auto it = m_compatViewFormats.find(uint64_t(v));
+      return (it != m_compatViewFormats.end()) ? it->second : VK_FORMAT_UNDEFINED;
+    };
+
+    std::vector<uint32_t> rpKey;
+    std::vector<VkAttachmentDescription> atts;
+    std::vector<VkAttachmentReference> colorRefs;
+    std::vector<VkImageView> fbViews;
+    std::vector<VkClearValue> clears;
+
+    auto sanitizeLoad = [&](VkAttachmentLoadOp op) -> VkAttachmentLoadOp {
+      return (!m_features.khrLoadStoreOpNone && op == VK_ATTACHMENT_LOAD_OP_NONE)
+        ? VK_ATTACHMENT_LOAD_OP_LOAD : op;
+    };
+    auto sanitizeStore = [&](VkAttachmentStoreOp op) -> VkAttachmentStoreOp {
+      return (!m_features.khrLoadStoreOpNone && op == VK_ATTACHMENT_STORE_OP_NONE)
+        ? VK_ATTACHMENT_STORE_OP_STORE : op;
+    };
+
+    auto sanitizeLayout = [&](VkImageLayout l, bool isDepth) -> VkImageLayout {
+      if (uint32_t(l) >= 1000000000u) {
+        Logger::err(str::format("beginCompatRenderPass: ext imageLayout=", uint32_t(l), " isDepth=", isDepth));
+        if (l == VK_IMAGE_LAYOUT_ATTACHMENT_OPTIMAL)
+          return isDepth ? VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        if (l == VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL)
+          return isDepth ? VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+      }
+      return l;
+    };
+
+    rpKey.push_back(info->colorAttachmentCount);
+    for (uint32_t i = 0; i < info->colorAttachmentCount; ++i) {
+      const auto& ca = info->pColorAttachments[i];
+      VkFormat fmt = ca.imageView ? getFmt(ca.imageView) : VK_FORMAT_UNDEFINED;
+      VkAttachmentLoadOp cLoad = sanitizeLoad(ca.loadOp);
+      VkAttachmentStoreOp cStore = sanitizeStore(ca.storeOp);
+      VkImageLayout cLayout = sanitizeLayout(ca.imageLayout, false);
+      rpKey.push_back(uint32_t(fmt));
+      rpKey.push_back(uint32_t(cLoad));
+      rpKey.push_back(uint32_t(cStore));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_LOAD_OP_DONT_CARE));
+      rpKey.push_back(uint32_t(VK_ATTACHMENT_STORE_OP_DONT_CARE));
+      rpKey.push_back(uint32_t(cLayout));
+      if (ca.imageView && fmt != VK_FORMAT_UNDEFINED) {
+        VkAttachmentDescription d = {};
+        d.format = fmt;
+        d.samples = VK_SAMPLE_COUNT_1_BIT;
+        d.loadOp = cLoad;
+        d.storeOp = cStore;
+        d.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        d.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        d.initialLayout = cLayout;
+        d.finalLayout = cLayout;
+        colorRefs.push_back({ uint32_t(atts.size()), cLayout });
+        atts.push_back(d);
+        fbViews.push_back(ca.imageView);
+        clears.push_back(ca.clearValue);
+      } else {
+        colorRefs.push_back({ VK_ATTACHMENT_UNUSED, VK_IMAGE_LAYOUT_UNDEFINED });
+      }
+    }
+
+    const VkRenderingAttachmentInfo* dsAtt = info->pDepthAttachment ? info->pDepthAttachment : info->pStencilAttachment;
+    VkFormat dsFmt = (dsAtt && dsAtt->imageView) ? getFmt(dsAtt->imageView) : VK_FORMAT_UNDEFINED;
+    rpKey.push_back(uint32_t(dsFmt));
+    VkAttachmentReference depthRef = { VK_ATTACHMENT_UNUSED, VK_IMAGE_LAYOUT_UNDEFINED };
+    if (dsFmt != VK_FORMAT_UNDEFINED) {
+      VkAttachmentLoadOp dLoad = sanitizeLoad(info->pDepthAttachment ? info->pDepthAttachment->loadOp : VK_ATTACHMENT_LOAD_OP_DONT_CARE);
+      VkAttachmentStoreOp dStore = sanitizeStore(info->pDepthAttachment ? info->pDepthAttachment->storeOp : VK_ATTACHMENT_STORE_OP_DONT_CARE);
+      VkAttachmentLoadOp sLoad = sanitizeLoad(info->pStencilAttachment ? info->pStencilAttachment->loadOp : VK_ATTACHMENT_LOAD_OP_DONT_CARE);
+      VkAttachmentStoreOp sStore = sanitizeStore(info->pStencilAttachment ? info->pStencilAttachment->storeOp : VK_ATTACHMENT_STORE_OP_DONT_CARE);
+      VkImageLayout dsLayout = sanitizeLayout(dsAtt->imageLayout, true);
+      rpKey.push_back(uint32_t(dLoad));
+      rpKey.push_back(uint32_t(dStore));
+      rpKey.push_back(uint32_t(sLoad));
+      rpKey.push_back(uint32_t(sStore));
+      rpKey.push_back(uint32_t(dsLayout));
+
+      VkAttachmentDescription d = {};
+      d.format = dsFmt;
+      d.samples = VK_SAMPLE_COUNT_1_BIT;
+      d.loadOp = dLoad;
+      d.storeOp = dStore;
+      d.stencilLoadOp = sLoad;
+      d.stencilStoreOp = sStore;
+      d.initialLayout = dsLayout;
+      d.finalLayout = dsLayout;
+      depthRef = { uint32_t(atts.size()), dsLayout };
+      atts.push_back(d);
+      fbViews.push_back(dsAtt->imageView);
+      VkClearValue cv = dsAtt->clearValue;
+      if (info->pStencilAttachment)
+        cv.depthStencil.stencil = info->pStencilAttachment->clearValue.depthStencil.stencil;
+      clears.push_back(cv);
+    }
+
+    if (atts.empty()) {
+      Logger::err(str::format("beginCompatRenderPass: atts.empty()! colors=", info->colorAttachmentCount,
+        " dsAtt=", (dsAtt != nullptr), " area=", info->renderArea.extent.width, "x", info->renderArea.extent.height));
+      return;
+    }
+
+    if (info->flags != 0) {
+      Logger::err(str::format("beginCompatRenderPass: non-zero flags=0x", std::hex, info->flags));
+    }
+
+    VkRenderPass rp = VK_NULL_HANDLE;
+    auto rpIt = m_compatRenderPasses.find(rpKey);
+    if (rpIt != m_compatRenderPasses.end()) {
+      rp = rpIt->second;
+    } else {
+      VkSubpassDescription subpass = {};
+      subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+      subpass.colorAttachmentCount = uint32_t(colorRefs.size());
+      subpass.pColorAttachments = colorRefs.empty() ? nullptr : colorRefs.data();
+      subpass.pDepthStencilAttachment = (dsFmt != VK_FORMAT_UNDEFINED) ? &depthRef : nullptr;
+
+      VkRenderPassCreateInfo rpInfo = { VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO };
+      rpInfo.attachmentCount = uint32_t(atts.size());
+      rpInfo.pAttachments = atts.empty() ? nullptr : atts.data();
+      rpInfo.subpassCount = 1;
+      rpInfo.pSubpasses = &subpass;
+
+      if (m_vkd->vkCreateRenderPass(m_vkd->device(), &rpInfo, nullptr, &rp) != VK_SUCCESS)
+        throw DxvkError("Failed to create compat VkRenderPass");
+      m_compatRenderPasses.emplace(rpKey, rp);
+    }
+
+    uint32_t fbWidth = info->renderArea.offset.x + info->renderArea.extent.width;
+    uint32_t fbHeight = info->renderArea.offset.y + info->renderArea.extent.height;
+    std::vector<uint64_t> fbKey;
+    fbKey.push_back(uint64_t(rp));
+    fbKey.push_back(uint64_t(fbWidth) | (uint64_t(fbHeight) << 32));
+    fbKey.push_back(uint64_t(info->layerCount ? info->layerCount : 1u));
+    for (VkImageView v : fbViews)
+      fbKey.push_back(uint64_t(v));
+
+    VkFramebuffer fb = VK_NULL_HANDLE;
+    auto fbIt = m_compatFramebuffers.find(fbKey);
+    if (fbIt != m_compatFramebuffers.end()) {
+      fb = fbIt->second;
+    } else {
+      VkFramebufferCreateInfo fbInfo = { VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO };
+      fbInfo.renderPass = rp;
+      fbInfo.attachmentCount = uint32_t(fbViews.size());
+      fbInfo.pAttachments = fbViews.empty() ? nullptr : fbViews.data();
+      fbInfo.width = fbWidth ? fbWidth : 1u;
+      fbInfo.height = fbHeight ? fbHeight : 1u;
+      fbInfo.layers = info->layerCount ? info->layerCount : 1u;
+      if (m_vkd->vkCreateFramebuffer(m_vkd->device(), &fbInfo, nullptr, &fb) != VK_SUCCESS)
+        throw DxvkError("Failed to create compat VkFramebuffer");
+      m_compatFramebuffers.emplace(fbKey, fb);
+      for (VkImageView v : fbViews)
+        m_compatViewToFbs[uint64_t(v)].push_back(fbKey);
+    }
+
+    if (m_compatActiveCmdBuffers[uint64_t(cmdBuffer)]) {
+      Logger::warn("DxvkDevice::beginCompatRenderPass: ending previous active compat render pass on cmdBuffer");
+      m_vkd->vkCmdEndRenderPass(cmdBuffer);
+      m_compatActiveCmdBuffers[uint64_t(cmdBuffer)] = false;
+    }
+
+    VkRenderPassBeginInfo beginInfo = { VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO };
+    beginInfo.renderPass = rp;
+    beginInfo.framebuffer = fb;
+    beginInfo.renderArea = info->renderArea;
+    if (beginInfo.renderArea.extent.width == 0 || beginInfo.renderArea.extent.height == 0) {
+      Logger::err(str::format("beginCompatRenderPass: zero renderArea ", beginInfo.renderArea.extent.width, "x", beginInfo.renderArea.extent.height));
+      beginInfo.renderArea.extent.width = fbWidth ? fbWidth : 1u;
+      beginInfo.renderArea.extent.height = fbHeight ? fbHeight : 1u;
+    }
+    beginInfo.clearValueCount = uint32_t(clears.size());
+    beginInfo.pClearValues = clears.empty() ? nullptr : clears.data();
+    m_vkd->vkCmdBeginRenderPass(cmdBuffer, &beginInfo, VK_SUBPASS_CONTENTS_INLINE);
+    m_compatActiveCmdBuffers[uint64_t(cmdBuffer)] = true;
+  }
+
+  void DxvkDevice::endCompatRenderPass(VkCommandBuffer cmdBuffer) {
+    std::lock_guard<std::mutex> lock(m_compatMutex);
+    auto it = m_compatActiveCmdBuffers.find(uint64_t(cmdBuffer));
+    if (it != m_compatActiveCmdBuffers.end() && it->second) {
+      it->second = false;
+      m_vkd->vkCmdEndRenderPass(cmdBuffer);
+    } else {
+      Logger::warn("DxvkDevice::endCompatRenderPass: skipped vkCmdEndRenderPass on inactive cmdBuffer");
+    }
+  }
+
+  void dxvkBeginCompatRenderPass(
+          DxvkDevice*               device,
+          VkCommandBuffer           cmdBuffer,
+    const VkRenderingInfo*          info) {
+    device->beginCompatRenderPass(cmdBuffer, info);
+  }
+
+  void dxvkEndCompatRenderPass(
+          DxvkDevice*               device,
+          VkCommandBuffer           cmdBuffer) {
+    device->endCompatRenderPass(cmdBuffer);
+  }
+
 }
